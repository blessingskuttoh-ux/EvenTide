<section id="booking" class="section booking-section">
  <div class="booking-card">
    <div class="booking-copy">
      <p class="eyebrow">Plan your next experience</p>
      <h2>Let’s make your next event feel effortless.</h2>
      <p>
        Share your details and we’ll help you choose the perfect experience.
      </p>
    </div>

    <form id="bookingForm" class="booking-form">
      <input type="text" name="name" placeholder="Your name" required />
      <input type="email" name="email" placeholder="Email address" required />
      <input type="text" name="event" placeholder="Preferred event" required />
      <input type="text" name="budget" placeholder="Budget range" />
      <input type="date" name="date" />
      <input type="time" name="time" />
      <input type="text" name="venue" placeholder="Preferred venue" />
      <input
        type="number"
        name="guests"
        min="1"
        placeholder="Number of guests"
      />
      <textarea
        name="message"
        rows="4"
        placeholder="Tell us what you’re looking for"
      ></textarea>
      <button type="submit">Request Invitation</button>
      <p id="formStatus" class="form-status" aria-live="polite"></p>
    </form>
  </div>
</section>
